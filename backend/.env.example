# MetrixSense — Environment Configuration
# Copy this file to backend/.env and fill in your Ozon API credentials.
# NOTE: these are placeholder values, not real keys.

OZON_SELLER_CLIENT_ID=your_client_id
OZON_SELLER_API_KEY=your_seller_api_key

OZON_PERFORMANCE_CLIENT_ID=your_performance_client_id
OZON_PERFORMANCE_SECRET=your_performance_secret

HOST=127.0.0.1
PORT=8000
DEBUG=false

LOG_SQL=false

DEFAULT_USERNAME=metrixsense
DEFAULT_PASSWORD=metrixsense

SECRET_KEY=

DEFAULT_TAX_SYSTEM=usn_6
DEFAULT_AD_BUDGET=5
DEFAULT_LOGISTICS_COST=150
DEFAULT_FBO=false

