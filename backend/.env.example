# MetrixSense — Environment Configuration
# Copy this file to backend/.env and fill in your Ozon API credentials.
# NOTE: these are placeholder values, not real keys.

# Ozon Seller API
# Get these from https://seller.ozon.ru/app/settings/api-keys
OZON_SELLER_CLIENT_ID=your_client_id
OZON_SELLER_API_KEY=your_seller_api_key

# Ozon Performance API (Advertising) — optional
# Get these from https://performance.ozon.ru/app/settings/api-keys
OZON_PERFORMANCE_CLIENT_ID=your_performance_client_id
OZON_PERFORMANCE_SECRET=your_performance_secret

# Server
# 127.0.0.1 — доступ только с этого компьютера (рекомендуется).
# 0.0.0.0 — доступ из локальной сети (только если вы понимаете риски).
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Default admin user created on first start
DEFAULT_USERNAME=metrixsense
DEFAULT_PASSWORD=metrixsense

# JWT secret. Leave empty to auto-generate and store in backend/data/.secret_key
SECRET_KEY=

# Default user settings
DEFAULT_TAX_SYSTEM=usn_6
DEFAULT_AD_BUDGET=5
DEFAULT_LOGISTICS_COST=150
DEFAULT_FBO=false

